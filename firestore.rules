rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny for unmatched documents
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'mrachmanfm@gmail.com';
    }

    function isOwner(userId) {
      return isAuthenticated() && (request.auth.uid == userId || request.auth.token.email == userId);
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ===============================================================
    // Users Collection (Shared between Apps)
    // ===============================================================
    match /users/{userId} {
      // Allow reading profiles for authenticated users / friends / leaderboard
      allow read: if isAuthenticated();
      // Owner or Super Admin can create and update profile
      allow write: if isOwner(userId) || isSuperAdmin();

      // Subcollection: sessions (App 2)
      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: history (App 2)
      match /history/{historyId} {
        allow read, write: if isOwner(userId);
      }

      // Subcollection: friend_requests (App 2)
      match /friend_requests/{senderId} {
        // Owner can read their incoming requests
        allow read: if isOwner(userId);
        // Anyone authenticated can send a friend request
        allow write: if isAuthenticated();
      }

      // Subcollection: friends (App 2)
      match /friends/{friendId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ===============================================================
    // Learning & Quiz App Collections (App 2)
    // ===============================================================
    match /benchmark_scores/{scoreId} {
      // Anyone can read the benchmark leaderboard
      allow read: if true;
      // Authenticated users can submit their scores
      allow write: if isAuthenticated();
    }

    match /global_leaderboard/{scoreId} {
      // Anyone can read the global leaderboard
      allow read: if true;
      // Authenticated users can submit their scores
      allow write: if isAuthenticated();
    }

    match /test_packages/{packageId} {
      // Anyone can read test packages
      allow read: if true;
      // Allow anyone to write test packages (guest access support)
      allow write: if true;
    }

    match /bank_soal/{questionId} {
      allow read, write: if true;
    }

    match /article_questions/{questionId} {
      allow read: if true;
      allow write: if true;
    }

    match /battles/{battleId} {
      // Authenticated users can read and write battle rooms
      allow read, write: if isAuthenticated();
    }

    // ===============================================================
    // Classify Pro Collections (Class Management App)
    // ===============================================================
    // Role Claim Requests (Google Auth Claim Flow)
    match /roleClaimRequests/{claimId} {
      allow read: if isSignedIn() && (request.auth.token.email == resource.data.google_email || isSuperAdmin());
      allow create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // Role assignments (Super Admin only write, all members can read)
    match /roleAssignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Class Information & Metadata
    match /classInfo/{classId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Semesters & Academic Settings
    match /semesters/{semesterId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Courses & Syllabuses
    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /syllabuses/{syllabusId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Finance: Transactions, Bills, Payments
    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /bills/{billId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isOwner(resource.data.user_id) || isSuperAdmin() || !exists(resource));
      allow delete: if isSuperAdmin();
    }

    // Kas Matrix & Checklist (Absensi 1 - 39)
    match /kasColumns/{columnId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    match /kasEntries/{entryId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Announcements & News
    match /announcements/{announcementId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Meetings & Minutes
    match /meetings/{meetingId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Tasks & Assignments
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Documents & Archive
    match /documents/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Polls & Voting
    match /polls/{pollId} {
      allow read: if isSignedIn();
      allow create, delete: if isSuperAdmin();
      allow update: if isSignedIn();
    }

    // Attendances
    match /attendances/{attendanceId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (
        resource.data.user_id == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.user_id == 'all' ||
        isSuperAdmin()
      );
      allow create, update: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Audit Logs
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // System & Webhook Config
    match /systemSettings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }
  }
}
